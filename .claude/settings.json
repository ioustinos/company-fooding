{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push origin main)",
      "Bash(git push origin main *)",
      "Bash(git push origin caterplan)",
      "Bash(git push origin caterplan *)",
      "Bash(git push * --force*)",
      "Bash(git push --force*)",
      "Bash(git push * -f*)",
      "Bash(git push -f*)",
      "Bash(git push --mirror*)",
      "Bash(git add -A*)",
      "Bash(git add --all*)",
      "Bash(git add .)",
      "Bash(git add . *)",
      "Bash(git commit -a*)",
      "Bash(git commit --all*)",
      "Bash(git commit -am*)",
      "Bash(netlify deploy *--prod*)",
      "Bash(npx netlify deploy *--prod*)",
      "Bash(netlify deploy *-p*)",
      "Bash(npx netlify deploy *-p*)"
    ],
    "ask": [
      "Bash(supabase db push*)",
      "Bash(npx supabase db push*)"
    ],
    "additionalDirectories": [
      "/Users/ioustinossarris/Documents/Claude/Projects/Claude Code/Orexxis/company-fooding-caterplan"
    ]
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/block-main-push.sh"
          }
        ]
      }
    ]
  }
}
